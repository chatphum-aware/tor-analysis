# Copy this file to .env and fill in real values. Never commit .env.

# Which LLM provider to use: anthropic | openai | gemini | openai_compat
TOR_PROVIDER=anthropic

# API key for the selected provider. The variable name depends on TOR_PROVIDER:
#   anthropic     -> ANTHROPIC_API_KEY
#   openai        -> OPENAI_API_KEY
#   gemini        -> GEMINI_API_KEY
#   openai_compat -> TOR_PROVIDER_API_KEY
ANTHROPIC_API_KEY=

# Only openai_compat needs a base URL (Ollama, vLLM, Together, Groq, OpenRouter, ...)
# TOR_PROVIDER_BASE_URL=http://localhost:11434/v1

# Model used for extraction
# Dev / prompt iteration: claude-haiku-4-5 or claude-sonnet-5 (cheaper)
# Real eval run:          claude-opus-5
TOR_MODEL=claude-opus-5

# Optional: run specific field groups on a different provider/model.
# Format: TOR_GROUP_<GROUP>="<provider>:<model>"
# Groups: basic_info | key_dates | bonds | qualifications | deliverables | misc
# Eval (2026-09-02) found cheap models break the source/null rules on the
# list-heavy groups, so this is the cost/reliability lever:
# TOR_GROUP_QUALIFICATIONS=anthropic:claude-opus-5
# TOR_GROUP_KEY_DATES=anthropic:claude-opus-5

# Exchange rate for displaying cost in Thai baht (estimate)
# Must be updated periodically -- the rate used is always shown alongside the number.
USD_THB_RATE=36.50
USD_THB_RATE_DATE=2026-08-28

# Max upload file size (MB)
MAX_UPLOAD_MB=50

# Frontend origin(s) allowed to call the API (comma-separated if more than one)
CORS_ORIGINS=http://localhost:5173

# Max time (seconds) allowed for one analysis run before returning 504
EXTRACTION_TIMEOUT_SECONDS=300

# --- vision OCR tuning (scanned PDFs) ---
# Max scanned pages sent to a vision model in one request. A document with
# more image-only pages than this is rejected with a clear 422, not silently
# truncated. Real Thai TORs routinely run 80-200 pages, so most large scanned
# documents will hit this default -- raise it only if you've confirmed your
# provider/model handles that many images in one call.
# TOR_MAX_VISION_PAGES=20

# Max combined byte size of the rendered page images sent to the vision
# model. A second, independent cap alongside TOR_MAX_VISION_PAGES -- page
# count alone doesn't bound payload size (a 16-page document already hit
# this before page count did; see PROGRESS.md).
# TOR_MAX_VISION_PAYLOAD_BYTES=20971520

# openai_compat only: opt into sending images to the endpoint. Off by
# default because there's no reliable way to auto-detect whether a given
# OpenAI-compatible endpoint actually reads an image or silently answers
# from caption text alone -- a stack that ignores the image still returns a
# schema-valid response, so this has to be a deliberate operator choice.
# TOR_OPENAI_COMPAT_VISION=1

# --- input formats ---
# XLSX ingestion is implemented and unit-tested but OFF by default: no real
# Thai government TOR was found in .xlsx (they are PDF from e-GP, or DOC/DOCX
# drafts), and the Excel files that do appear in procurement are attachments
# like BOQ / price-breakdown sheets whose contents don't map onto this tool's
# TOR fields. Set to 1 only if you actually have TOR spreadsheets -- note it
# has not been verified against a live model run yet, and the frontend's file
# picker also needs .xlsx added back (see UploadPane.tsx).
# TOR_ENABLE_XLSX=1
